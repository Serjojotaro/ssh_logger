[Unit]
Description=SSH Notifier to Telegram
After=network-online.target
Wants=network-online.target

[Service]
# Файл с TELEGRAM_TOKEN / TELEGRAM_CHAT_ID, chmod 600 (см. readme)
EnvironmentFile=-/etc/ssh_notifier.env
ExecStart=/usr/bin/python3 /usr/bin/ssh_logger.py
Restart=always
RestartSec=5
# exit(1) — это отсутствующая конфигурация; рестартить бессмысленно
RestartPreventExitStatus=1
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# синхронно STATE_FILE, если переопределён в env
ReadWritePaths=/var/lib/ssh_notifier

[Install]
WantedBy=multi-user.target
